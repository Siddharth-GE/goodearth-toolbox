# WHICH DATABASE IS THIS?
#
# There are two, and they are not interchangeable:
#
#   goodearth-toolbox          pajfrgnkapicdgangjey   PRODUCTION. Real
#                              work, real staff, real client money.
#   goodearth-toolbox-staging  ipstebqawrvhkyntctrv   STAGING. Everything
#                              the toolbox was built with, and where
#                              features are tried.
#
# ON THIS MACHINE, THESE POINT AT STAGING. `npm run dev` must not write to
# the database seventy people depend on. Production's values live in
# Vercel's Production environment and nowhere else.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets — never prefix with NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
MARATHON_SESSION_SECRET=

# The app's own absolute URL — password-reset links and the Google
# sign-in callback are built from it. http://localhost:3000 locally,
# https://staging.goodearthkannur.org on staging, the production URL on
# production.
SITE_URL=
# Signs the 2FA challenge / verified-session / trusted-device cookies.
# Any long random string; rotating it signs everyone out of 2FA state
# (they re-fetch a code on next login). Not shared with MARATHON_SESSION_SECRET
# on purpose — rotating one must not touch the other.
#
# Production and staging have DIFFERENT values, so that rotating one
# cannot sign anyone out of the other.
AUTH_COOKIE_SECRET=

# The management API key — account-level, so it reaches BOTH projects.
# Local only, never in app code, never in Vercel. Everything in scripts/
# that touches a database takes the project ref on the command line and
# never defaults it; this key is why that rule matters.
SUPABASE_ACCESS_TOKEN=

# The Google Chat bot (Relay slash commands). Google signs every request
# with an ID token; /api/google-chat refuses everything until both of
# these are set. Staging and production are SEPARATE Chat apps, so both
# values differ per environment.
#
# The Cloud project number names the only Google identity the door
# accepts: service-<number>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com.
GOOGLE_CHAT_PROJECT_NUMBER=
# The endpoint URL exactly as registered in the Chat app's connection
# settings — Google stamps it as the token audience, character for
# character (e.g. https://staging.goodearthkannur.org/api/google-chat).
GOOGLE_CHAT_AUDIENCE=
# Optional comma-separated allow-list of Google space IDs ("spaces/AAAA").
# Unset = any space in the Workspace may talk to the bot.
GOOGLE_CHAT_ALLOWED_SPACES=
