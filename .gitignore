# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# supabase CLI local cache (project ref link, not a secret, just noise)
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch notes, not part of the project's documentation
REPO-MAP.md

# source CSVs for one-off imports (scripts/import-catalogue.ts) — business
# data belongs in the database, not in git history
/data

# assistant tooling — local working files, not part of the project.
# (.github/workflows IS the project's CI and stays tracked.)
/.claude
/.impeccable
/.github/skills
/.github/agents
/.github/hooks
vercel-env-values.txt

.vercel
